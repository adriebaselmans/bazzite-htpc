#!/usr/bin/python3
"""Install consistent Game Mode artwork for HTPC streaming shortcuts."""
from pathlib import Path
import os
import subprocess
import sys

import vdf


def main():
    files = sorted(Path.home().glob(".local/share/Steam/userdata/*/config/shortcuts.vdf"))
    if not files:
        print("    No Steam shortcuts.vdf found; start Steam once first.")
        return 0
    if subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        print("    Close Steam completely before applying tile artwork.")
        return 0

    path = files[0]
    with path.open("rb") as handle:
        data = vdf.binary_load(handle)
    grid = path.parent / "grid"
    grid.mkdir(exist_ok=True)
    changed = False

    for shortcut in data.get("shortcuts", {}).values():
        name = shortcut.get("appname", "").lower()
        if name not in {"freetube", "spotify"}:
            continue
        try:
            appid = int(shortcut["appid"]) & 0xFFFFFFFF
        except (KeyError, TypeError, ValueError):
            continue
        source = Path("/usr/share/htpc-artwork") / f"{name}.svg"
        subprocess.run(["magick", str(source), "-resize", "920x430!",
                        str(grid / f"{appid}.png")], check=True)
        subprocess.run(["magick", str(source), "-resize", "600x900^",
                        "-gravity", "center", "-extent", "600x900",
                        str(grid / f"{appid}p.png")], check=True)
        subprocess.run(["magick", str(source), "-resize", "256x256^",
                        "-gravity", "center", "-extent", "256x256",
                        str(grid / f"{appid}_icon.png")], check=True)
        shortcut["icon"] = str(grid / f"{appid}_icon.png")
        changed = True
        print(f"    Artwork applied to {shortcut.get('appname')} ({appid}).")

    if changed:
        tmp = path.with_suffix(".vdf.tmp")
        with tmp.open("wb") as handle:
            vdf.binary_dump(data, handle)
        os.replace(tmp, path)
        print("    Restart Steam to reload shortcuts and artwork.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
