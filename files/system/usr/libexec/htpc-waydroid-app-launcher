#!/usr/bin/bash
# Run one Android TV app inside Bazzite's cage wrapper. If Android is shut down
# from its own UI, close cage too instead of leaving gamescope on a black screen.
set -euo pipefail

if [[ "$#" -ne 1 ]]; then
    echo "Usage: $0 ANDROID_PACKAGE" >&2
    exit 2
fi

package="$1"
launcher_pid=""
app_list=""
keyboard_monitor_pid=""

cleanup() {
    trap - EXIT INT TERM HUP
    [[ -z "$app_list" ]] || rm -f "$app_list"
    if [[ -n "$keyboard_monitor_pid" ]]; then
        kill "$keyboard_monitor_pid" 2>/dev/null || true
    fi
    if pgrep -x cage >/dev/null 2>&1; then
        pkill -TERM -x cage || true
        for _ in {1..5}; do
            pgrep -x cage >/dev/null 2>&1 || break
            sleep 0.2
        done
        # cage can ignore TERM after its Android client has disappeared.
        pgrep -x cage >/dev/null 2>&1 && pkill -KILL -x cage || true
    fi
    if [[ -n "$launcher_pid" ]]; then
        wait "$launcher_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM HUP

/usr/libexec/htpc-waydroid-keyboard-exit "$$" &
keyboard_monitor_pid=$!

/usr/bin/waydroid-launcher show-full-ui &
launcher_pid=$!

# surfaceflinger appears several seconds before Waydroid's host API and Android
# package manager are usable. Launching at that point hangs in
# "Failed to get service waydroidplatform" and leaves Android TV Home visible.
# Require a successful app listing that includes the requested package.
ready=0
app_list="$(mktemp)"
deadline=$((SECONDS + 90))
while ((SECONDS < deadline)); do
    if ! kill -0 "$launcher_pid" 2>/dev/null; then
        echo "Waydroid launcher exited before Android was ready." >&2
        exit 1
    fi
    if timeout 3 waydroid app list >"$app_list" 2>/dev/null \
            && grep -Fq "packageName: $package" "$app_list"; then
        ready=1
        break
    fi
    sleep 1
done

if [[ "$ready" -ne 1 ]]; then
    echo "Android or package $package did not become ready within 90 seconds." >&2
    exit 1
fi

rm -f "$app_list"
app_list=""
timeout 15 waydroid app launch "$package"

# Bazzite's launcher only watches cage. Android's Shutdown stops surfaceflinger
# but leaves cage alive, producing a permanent black screen. Close cage when
# either Android or the owning launcher disappears.
while kill -0 "$launcher_pid" 2>/dev/null; do
    pgrep -x surfaceflinger >/dev/null 2>&1 || break
    sleep 1
done
