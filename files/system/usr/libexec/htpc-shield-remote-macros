#!/usr/bin/python3
"""HTPC-specific actions for the NVIDIA Shield 2019 remote.

Launches through Steam (steam://rungameid/...), not `flatpak run`. In Game
Mode gamescope is the shell and Steam owns the windows; starting the flatpak
directly puts an app next to gamescope that nothing manages - the same class
of failure as the reverted post_gamescope_start hook and the Waydroid/cage
black screen (both in CLAUDE.md). Going through Steam makes the button behave
exactly like selecting the Kodi tile, exit included.

The appid is read from shortcuts.vdf at each press rather than hardcoded:
`ujust htpc-steam-shortcut` rewrites that file and hands out a new appid, so a
baked-in value would silently start launching nothing.

Runs as a *user* service. Starting a flatpak (or Steam) from a root service
and dropping privileges fails in the sandbox with "bwrap: Can't find source
path /run/user/1000/doc/by-app/tv.kodi.Kodi: Permission denied" - the document
portal rejects a caller with no real session behind it. Reading the remote's
evdev node as the user works because 91-htpc-shield-remote-uaccess.rules sets
its owner.

The remote's back scancode is mapped to Escape at the host level because Steam
Game Mode ignores Linux KEY_BACK. Android needs the opposite: SmartTube treats
Escape as a keyboard key, while Linux KEY_BACK becomes Android's real Back
action. This service mirrors the physical remote through uinput. Escape remains
Escape for Steam/Kodi, but becomes only KEY_BACK while Waydroid is active; a
long hold exits the complete Waydroid tile.
"""
import glob
import re
import struct
import subprocess
import time

import evdev
from evdev import ecodes

DEVICE_NAME = "NVIDIA SHIELD Remote"
SHORTCUT_NAME = "Kodi"
SHORTCUTS_GLOB = "/home/adrie/.local/share/Steam/userdata/*/config/shortcuts.vdf"

# Ignore repeat presses inside this window. The button is easy to press twice,
# and Steam needs several seconds before a launch is observable anywhere - so
# "is it running yet?" cannot be the only guard. Without this, four impatient
# presses started four Kodis that fought over the display and wedged the box.
DEBOUNCE_SECONDS = 10.0
WAYDROID_EXIT_HOLD_SECONDS = 1.2

# Binary VDF: 0x02 marks an int32 field, 0x01 a string field.
_ENTRY = re.compile(rb"\x02appid\x00(....)\x01appname\x00([^\x00]*)\x00", re.S)


def find_device():
    for path in evdev.list_devices():
        device = evdev.InputDevice(path)
        if device.name == DEVICE_NAME:
            return device
    return None


def kodi_rungameid():
    """Resolve the Kodi shortcut's steam://rungameid target, or None."""
    for path in glob.glob(SHORTCUTS_GLOB):
        try:
            with open(path, "rb") as handle:
                data = handle.read()
        except OSError:
            continue
        for match in _ENTRY.finditer(data):
            name = match.group(2).decode("utf-8", "replace")
            if name == SHORTCUT_NAME:
                appid = struct.unpack("<I", match.group(1))[0]
                # Non-Steam shortcuts address as (appid << 32) | 0x02000000.
                return (appid << 32) | 0x02000000
    return None


def kodi_running():
    result = subprocess.run(["/usr/bin/pgrep", "-x", "kodi.bin"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def launch_kodi():
    if kodi_running():
        return
    rungameid = kodi_rungameid()
    if rungameid is None:
        return
    subprocess.Popen(
        ["/usr/bin/steam", f"steam://rungameid/{rungameid}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def waydroid_running():
    result = subprocess.run(["/usr/bin/pgrep", "-x", "surfaceflinger"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def emit_android_back(output, value):
    output.write(ecodes.EV_KEY, ecodes.KEY_BACK, value)
    output.syn()


def emit_key(output, code, value):
    output.write(ecodes.EV_KEY, code, value)
    output.syn()


def exit_waydroid():
    result = subprocess.run([
        "/usr/bin/pkill", "-TERM", "-f",
        r"^/usr/bin/bash /usr/libexec/htpc-waydroid-app-launcher "
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if result.returncode != 0:
        subprocess.run(["/usr/bin/pkill", "-TERM", "-x", "cage"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    last_press = 0.0
    while True:
        device = find_device()
        if device is None:
            time.sleep(2)
            continue
        forwarding_back = False
        back_started = 0.0
        try:
            # Grab the physical keyboard and mirror its keys through uinput.
            # This lets Escape become *only* Android Back in Waydroid instead
            # of reaching Steam at the same time. The grab is automatically
            # released if this service exits or Bluetooth disconnects.
            capabilities = device.capabilities(absinfo=False)
            capabilities.pop(ecodes.EV_SYN, None)
            capabilities.pop(ecodes.EV_FF, None)
            keys = capabilities.setdefault(ecodes.EV_KEY, [])
            if ecodes.KEY_BACK not in keys:
                keys.append(ecodes.KEY_BACK)
            with evdev.UInput(capabilities,
                             name="HTPC Shield Remote") as output:
                device.grab()
                for event in device.read_loop():
                    if event.type != ecodes.EV_KEY:
                        continue
                    if event.code == ecodes.KEY_ESC:
                        if event.value == 1:
                            forwarding_back = waydroid_running()
                            back_started = time.monotonic()
                        if forwarding_back:
                            # Ignore key-repeat: one physical hold must not race
                            # through several Android screens.
                            if event.value != 2:
                                emit_android_back(output, event.value)
                            if event.value == 0:
                                held = time.monotonic() - back_started
                                forwarding_back = False
                                if held >= WAYDROID_EXIT_HOLD_SECONDS:
                                    exit_waydroid()
                        else:
                            emit_key(output, event.code, event.value)
                        continue
                    if event.code != ecodes.KEY_VIDEO:
                        emit_key(output, event.code, event.value)
                        continue
                    if event.value != 1:
                        continue
                    now = time.monotonic()
                    if now - last_press < DEBOUNCE_SECONDS:
                        continue
                    last_press = now
                    launch_kodi()
        except OSError:
            # Bluetooth remote went away (suspend, out of range, powered off).
            continue


if __name__ == "__main__":
    main()
