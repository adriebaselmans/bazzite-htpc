#!/usr/bin/python3
"""Point the obsolete FreeTube/YouTube Steam shortcut at SmartTube."""
from pathlib import Path
import os
import shutil
import subprocess
import sys

import vdf


def main():
    files = sorted(Path.home().glob(".local/share/Steam/userdata/*/config/shortcuts.vdf"))
    if not files:
        return 2
    if subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        print("Close Steam completely before changing its shortcuts.", file=sys.stderr)
        return 1

    path = files[0]
    with path.open("rb") as handle:
        data = vdf.binary_load(handle)
    for shortcut in data.get("shortcuts", {}).values():
        if shortcut.get("appname", "").lower() not in {
            "freetube", "youtube", "smarttube"
        }:
            continue
        shortcut["appname"] = "SmartTube"
        shortcut["exe"] = '"/usr/libexec/htpc-smarttube-launcher"'
        shortcut["StartDir"] = "/usr/libexec/"
        shortcut["LaunchOptions"] = ""
        shortcut["ShortcutPath"] = ""
        shortcut["FlatpakAppID"] = ""
        shortcut["icon"] = "/usr/share/htpc-artwork/smarttube_squared.png"
        appid = int(shortcut["appid"]) & 0xFFFFFFFF
        grid = path.parent / "grid"
        grid.mkdir(exist_ok=True)
        artwork = Path("/usr/share/htpc-artwork")
        shutil.copyfile(artwork / "smarttube.png", grid / f"{appid}.png")
        shutil.copyfile(artwork / "smarttube_p.png", grid / f"{appid}p.png")
        shutil.copyfile(artwork / "smarttube_icon.png",
                        grid / f"{appid}_icon.png")
        tmp = path.with_suffix(".vdf.tmp")
        with tmp.open("wb") as handle:
            vdf.binary_dump(data, handle)
        os.replace(tmp, path)
        print("SmartTube launcher and Game Mode artwork installed.")
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
