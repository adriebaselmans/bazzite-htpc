#!/usr/bin/python3
"""Create/update the direct Android TV Spotify shortcut and its artwork."""
from pathlib import Path
import os
import shutil
import subprocess
import sys
import zlib

import vdf

APP_NAME = "Spotify"
EXE = '"/usr/libexec/htpc-spotify-launcher"'


def signed32(value):
    return value if value < 0x80000000 else value - 0x100000000


def main():
    files = sorted(Path.home().glob(".local/share/Steam/userdata/*/config/shortcuts.vdf"))
    if not files:
        print("Start Steam once before creating its Spotify shortcut.", file=sys.stderr)
        return 2
    if subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        print("Close Steam completely before changing its shortcuts.", file=sys.stderr)
        return 1

    path = files[0]
    with path.open("rb") as handle:
        data = vdf.binary_load(handle)
    shortcuts = data.setdefault("shortcuts", {})
    shortcut = next((item for item in shortcuts.values()
                     if item.get("appname", "").lower() == "spotify"), None)

    if shortcut is None:
        appid = zlib.crc32((EXE + APP_NAME).encode()) | 0x80000000
        keys = [int(key) for key in shortcuts if str(key).isdigit()]
        shortcut = {}
        shortcuts[str(max(keys, default=-1) + 1)] = shortcut
    else:
        appid = int(shortcut.get("appid", 0)) & 0xFFFFFFFF
        if not appid:
            appid = zlib.crc32((EXE + APP_NAME).encode()) | 0x80000000

    shortcut.update({
        "appid": signed32(appid),
        "appname": APP_NAME,
        "exe": EXE,
        "StartDir": "/usr/libexec/",
        "icon": "/usr/share/htpc-artwork/spotify_squared.png",
        "ShortcutPath": "",
        "LaunchOptions": "",
        "IsHidden": 0,
        "AllowDesktopConfig": 1,
        "AllowOverlay": 1,
        "OpenVR": 0,
        "Devkit": 0,
        "DevkitGameID": "",
        "DevkitOverrideAppID": 0,
        "LastPlayTime": 0,
        "FlatpakAppID": "",
        "sortas": "",
        "tags": {},
    })

    grid = path.parent / "grid"
    grid.mkdir(exist_ok=True)
    artwork = Path("/usr/share/htpc-artwork")
    shutil.copyfile(artwork / "spotify.png", grid / f"{appid}.png")
    shutil.copyfile(artwork / "spotify_p.png", grid / f"{appid}p.png")
    shutil.copyfile(artwork / "spotify_icon.png", grid / f"{appid}_icon.png")

    tmp = path.with_suffix(".vdf.tmp")
    with tmp.open("wb") as handle:
        vdf.binary_dump(data, handle)
    os.replace(tmp, path)
    print("Spotify now launches its Android TV app directly through Waydroid.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
